# URL of your Render backend, e.g. https://5minchat-backend.onrender.com
# Must NOT have a trailing slash.
VITE_BACKEND_URL=https://your-backend.onrender.com

# Cloudinary - used for direct-from-browser image uploads in the Feed tab.
# Create a free account at cloudinary.com, then Settings -> Upload ->
# "Add upload preset" -> set Signing Mode to "Unsigned" -> save, and copy
# the preset name and your cloud name here.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name

# Supabase Auth - powers Google login and email login for the Feed, Post,
# and Profile tabs. Find these at Project Settings -> API in your Supabase
# dashboard. Use the "Publishable key" (safe for browser use) - NOT the
# secret/service_role key, which only belongs on the backend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
